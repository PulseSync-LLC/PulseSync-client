{
    "name": "PulseSync",
    "productName": "PulseSync",
    "author": "PulseSync <contact@pulsesync.dev>",
    "description": "PulseSync app for desktops",
    "homepage": "https://pulsesync.dev",
    "version": "1.0.0",
    "main": ".vite/main/bootstrap.cjs",
    "scripts": {
        "start": "tsx scripts/dev-remote.ts",
        "dev:renderer": "tsx scripts/dev-remote-renderer.ts",
        "dev:remote": "tsx scripts/dev-remote.ts",
        "dev:native": "electron-forge start",
        "renderer:build": "tsx scripts/renderer/remote-renderer.ts build",
        "renderer:publish": "tsx scripts/renderer/remote-renderer.ts publish",
        "bootstrapper:build": "tsx scripts/bootstrapper/build.ts build",
        "bootstrapper:copy": "tsx scripts/bootstrapper/build.ts copy",
        "bootstrapper:check": "cargo check --manifest-path packages/bootstrapper/Cargo.toml",
        "bootstrapper:verify-build-layout": "tsx scripts/bootstrapper/verify-build-layout.ts",
        "bootstrapper:verify-package-layout": "tsx scripts/bootstrapper/verify-package-layout.ts",
        "bootstrapper:verify-setup-layout": "tsx scripts/bootstrapper/verify-setup-layout.ts",
        "bootstrapper:verify-macos-update": "cargo build --manifest-path packages/bootstrapper/Cargo.toml && tsx scripts/bootstrapper/verify-macos-update.ts",
        "bootstrapper:verify-launch-routing": "tsx scripts/bootstrapper/verify-launch-routing.ts",
        "bootstrapper:verify-release-routing": "tsx scripts/bootstrapper/verify-release-routing.ts",
        "release:manifest": "tsx scripts/desktop-release-manifest.ts",
        "build:package": "tsx scripts/build.ts --application --debug",
        "build:installer": "tsx scripts/build.ts --installer --debug",
        "build:nativeModules": "tsx scripts/build.ts --nativeModules --debug",
        "publish:api": "tsx scripts/changelog-publish.ts --api",
        "publish:discord": "tsx scripts/changelog-publish.ts --discord",
        "publish:beta": "tsx scripts/build.ts --application --publish beta --debug",
        "publish:alpha": "tsx scripts/build.ts --application --publish alpha --debug",
        "publish:dev": "tsx scripts/build.ts --application --publish dev --debug",
        "typecheck": "tsc -b --noEmit",
        "format": "prettier --write .",
        "updateDeps": "ncu -u"
    },
    "type": "module",
    "engines": {
        "node": "^22.0.0 || ^24.0.0 || ^25.0.0 || >=26.0.0"
    },
    "keywords": [],
    "license": "SEE LICENSE IN LICENSE",
